# Optional. An HTTP endpoint returning current Claude usage.
# Leave unset and the counter shows sample data.
#
# Expected response shape:
#   {
#     "session": { "used": 0.62, "resetsAt": "2026-08-26T22:00:00Z" },
#     "week":    { "used": 41, "limit": 100, "resetsInSeconds": 259200 }
#   }
#
# "used" is either a 0-1 fraction or a count paired with "limit".
# Reset time accepts an ISO timestamp, an epoch (seconds or ms), or
# "resetsInSeconds". The "week" object is optional.
#
# This is the build-time default; it can be overridden per device in
# Settings -> Claude Usage -> Endpoint.
EXPO_PUBLIC_CLAUDE_USAGE_ENDPOINT=
