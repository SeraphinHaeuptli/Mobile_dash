# Copy to .env.local and fill in only the services you want live.
# Anything left blank falls back to deterministic sample data — the dashboard
# still runs, and each affected widget shows a small "sample" badge.

# Stripe — https://dashboard.stripe.com/apikeys (a restricted read-only key is enough)
STRIPE_SECRET_KEY=

# Google Calendar — OAuth access token with calendar.readonly scope
GOOGLE_CALENDAR_TOKEN=

# Gmail — OAuth access token with gmail.readonly scope
GMAIL_TOKEN=

# GitHub — https://github.com/settings/tokens (classic or fine-grained, read-only)
GITHUB_TOKEN=

# Weather (Open-Meteo), RSS and System need no credentials.
